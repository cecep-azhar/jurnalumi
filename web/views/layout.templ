package views

import "github.com/cecep-azhar/jurnalumi/internal/models"

templ Layout(title string, tenant models.Tenant, user models.User, content templ.Component) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - JurnalUmi</title>
		<!-- Phase 6: PWA Manifest -->
		<link rel="manifest" href="/static/manifest.json" />
		<meta name="theme-color" content="#059669" />
		
		<script src="https://cdn.tailwindcss.com"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<style>
			[x-cloak] { display: none !important; }
		</style>
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans antialiased">
		
		<nav class="bg-emerald-600 text-white p-4 shadow-md flex justify-between items-center sticky top-0 z-40">
			<div class="font-bold text-xl flex items-center space-x-6">
				<a href="/dashboard" class="flex items-center hover:text-emerald-200 transition">
					<svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					JurnalUmi
				</a>

				<!-- Main Menu -->
				<div class="hidden md:flex items-center space-x-4 text-sm font-medium">
					<a href="/dashboard" class="hover:text-emerald-200 transition">Dashboard</a>
					<a href="/assets" class="hover:text-emerald-200 transition">Aset & Emas</a>
					<a href="/debts" class="hover:text-emerald-200 transition">Utang & Piutang</a>
					<a href="/reports" class="hover:text-emerald-200 transition">Laporan & Cetak</a>
					if user.Role == "owner" {
						<a href="/family" class="hover:text-emerald-200 transition">Manajemen Anggota</a>
					}
				</div>
			</div>

			<div class="text-sm flex items-center space-x-4">
				<span class="hidden md:inline">Keluarga: <b>{ tenant.Name }</b></span>
				<span class="font-semibold bg-emerald-700 px-3 py-1 rounded-full">{ user.Name } ({ user.Role })</span>
				<a href="/logout" class="text-emerald-200 hover:text-white font-semibold flex items-center" title="Keluar">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
				</a>
			</div>
		</nav>

		<main class="max-w-7xl mx-auto p-4 md:p-6 space-y-6">
			@content
		</main>

		<!-- Service Worker Registration -->
		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/static/sw.js');
				});
			}
		</script>
	</body>
	</html>
}
