package views

import "github.com/cecep-azhar/jurnalumi/internal/models"

templ ActivateVoucherGET(tenant models.Tenant, user models.User, message string, isError bool) {
	@Layout("Aktivasi Voucher", tenant, user, voucherContent(message, isError))
}

templ voucherContent(message string, isError bool) {
	<div class="max-w-xl mx-auto space-y-6">
		<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center">
			<div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
				<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
			</div>
			
			<h2 class="text-2xl font-bold text-gray-900">Aktivasi Voucher Premium</h2>
			<p class="text-gray-500 mt-2 mb-6">Tukarkan kode voucher Anda untuk mendapatkan akses premium JurnalUmi.</p>

			if message != "" {
				if isError {
					<div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm font-medium">
						{ message }
					</div>
				} else {
					<div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl text-sm font-medium">
						{ message }
					</div>
				}
			}

			<form action="/activate-voucher" method="POST" class="space-y-4">
				<input type="hidden" name="csrf_token" value={ ctx.Value("csrf").(string) } />
				
				<div class="text-left">
					<label class="block text-sm font-medium text-gray-700 mb-1">Kode Voucher</label>
					<input type="text" name="voucher_code" placeholder="JURNALUMI-XXXX-XXXX" required class="w-full text-center font-mono text-lg font-bold border-2 border-gray-300 rounded-xl px-4 py-3 focus:border-emerald-500 focus:ring-emerald-500 uppercase tracking-widest outline-none transition" />
				</div>
				
				<button type="submit" class="w-full flex justify-center items-center bg-gray-900 hover:bg-black text-white font-bold py-3 px-4 rounded-xl transition shadow-lg mt-4">
					Tukarkan Voucher
				</button>
			</form>
		</div>
	</div>
}
