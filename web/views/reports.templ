package views

import (
	"fmt"
	"github.com/cecep-azhar/jurnalumi/internal/models"
)

templ ReportView(tenant models.Tenant, user models.User, transactions []models.Transaction, totalIncome float64, totalExpense float64) {
	@Layout("Laporan Finansial & Cetak", tenant, user, reportContent(transactions, totalIncome, totalExpense))
}

templ reportContent(transactions []models.Transaction, totalIncome float64, totalExpense float64) {
	<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100" x-data="{ filterType: 'all', search: '' }">
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 border-b pb-4 gap-4">
			<div>
				<h3 class="font-bold text-2xl">Laporan & Audit Finansial</h3>
				<p class="text-gray-500 text-sm mt-1">Filter, pencarian cepat, dan cetak PDF / CSV transaksi keluarga.</p>
			</div>
			
			<div class="flex space-x-2">
				<button onclick="window.print()" class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded-xl text-sm font-bold shadow transition flex items-center">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
					Cetak Laporan PDF
				</button>
				<a href="/reports/export" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm font-bold shadow transition flex items-center">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
					Export CSV / Excel
				</a>
			</div>
		</div>

		<!-- Interactive Filter & Live Search via Alpine.js -->
		<div class="flex flex-col sm:flex-row gap-4 mb-6 bg-gray-50 p-4 rounded-xl">
			<div class="flex-1">
				<input type="text" x-model="search" placeholder="Cari keterangan atau kategori..." class="w-full border border-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-emerald-500 outline-none">
			</div>
			<div class="flex space-x-2">
				<button type="button" @click="filterType = 'all'" :class="filterType === 'all' ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-gray-700'" class="px-4 py-2 rounded-xl text-sm transition border">Semua</button>
				<button type="button" @click="filterType = 'income'" :class="filterType === 'income' ? 'bg-emerald-600 text-white font-bold' : 'bg-white text-gray-700'" class="px-4 py-2 rounded-xl text-sm transition border">Pemasukan</button>
				<button type="button" @click="filterType = 'expense'" :class="filterType === 'expense' ? 'bg-red-600 text-white font-bold' : 'bg-white text-gray-700'" class="px-4 py-2 rounded-xl text-sm transition border">Pengeluaran</button>
			</div>
		</div>

		<!-- Summary Card -->
		<div class="grid grid-cols-2 gap-4 mb-6">
			<div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl">
				<p class="text-xs text-emerald-700 font-bold uppercase">Total Pemasukan Terecord</p>
				<h4 class="text-xl font-bold text-emerald-800">{ FormatRupiah(totalIncome) }</h4>
			</div>
			<div class="bg-red-50 border border-red-200 p-4 rounded-xl">
				<p class="text-xs text-red-700 font-bold uppercase">Total Pengeluaran Terecord</p>
				<h4 class="text-xl font-bold text-red-800">{ FormatRupiah(totalExpense) }</h4>
			</div>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse min-w-full">
				<thead>
					<tr class="text-gray-400 text-xs uppercase tracking-wider border-b">
						<th class="pb-3 font-medium">Tanggal</th>
						<th class="pb-3 font-medium">Tipe</th>
						<th class="pb-3 font-medium">Kategori</th>
						<th class="pb-3 font-medium">Keterangan</th>
						<th class="pb-3 font-medium text-right">Nominal</th>
					</tr>
				</thead>
				<tbody class="text-sm">
					for _, t := range transactions {
						<tr class="border-b border-gray-100 hover:bg-gray-50 transition"
							x-show={ fmt.Sprintf("(filterType === 'all' || filterType === '%s') && ('%s'.toLowerCase().includes(search.toLowerCase()) || '%s'.toLowerCase().includes(search.toLowerCase()))", t.Type, t.CategoryName, t.Description) }>
							<td class="py-4 text-gray-500">{ t.TransactionDate.Format("02 Jan 2006, 15:04") }</td>
							<td class="py-4">
								if t.Type == "expense" {
									<span class="text-red-600 font-bold uppercase text-xs">Pengeluaran</span>
								} else {
									<span class="text-emerald-600 font-bold uppercase text-xs">Pemasukan</span>
								}
							</td>
							<td class="py-4 font-semibold">{ t.CategoryName }</td>
							<td class="py-4 text-gray-700">{ t.Description }</td>
							<td class="py-4 font-bold text-right">
								if t.Type == "expense" {
									<span class="text-red-600">- { FormatRupiah(t.Amount) }</span>
								} else {
									<span class="text-emerald-600">+ { FormatRupiah(t.Amount) }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
