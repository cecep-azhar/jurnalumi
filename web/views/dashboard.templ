package views

import (
	"fmt"
	"github.com/cecep-azhar/jurnalumi/internal/models"
)

templ Dashboard(tenant models.Tenant, user models.User, wallets []models.Wallet) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Dashboard - JurnalUmi</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js"></script>
		<style>
			[x-cloak] { display: none !important; }
		</style>
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans antialiased">
		
		<!-- Sidebar / Navbar (Simplified for PRD) -->
		<nav class="bg-emerald-600 text-white p-4 shadow-md flex justify-between items-center">
			<div class="font-bold text-xl">JurnalUmi</div>
			<div class="text-sm">
				<span class="mr-4">Keluarga: { tenant.Name }</span>
				<span class="font-semibold bg-emerald-700 px-3 py-1 rounded-full">{ user.Name } ({ user.Role })</span>
			</div>
		</nav>

		<main class="max-w-7xl mx-auto p-6 space-y-6" x-data="{ addTransactionModal: false }">
			
			<!-- Top Metrics -->
			<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
				<div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 border-l-4 border-l-blue-500">
					<p class="text-sm text-gray-500 mb-1">Total Saldo Likuid</p>
					<h3 class="text-2xl font-bold">Rp 4.500.000</h3>
				</div>
				<div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 border-l-4 border-l-emerald-500">
					<p class="text-sm text-gray-500 mb-1">Pemasukan Bulan Ini</p>
					<h3 class="text-2xl font-bold">Rp 12.000.000</h3>
				</div>
				<div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 border-l-4 border-l-red-500">
					<p class="text-sm text-gray-500 mb-1">Pengeluaran Bulan Ini</p>
					<h3 class="text-2xl font-bold">Rp 8.200.000</h3>
					<div class="mt-2 text-xs font-semibold text-red-600 bg-red-100 inline-block px-2 py-1 rounded">Over Budget Dapur!</div>
				</div>
				<div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 border-l-4 border-l-purple-500 relative">
					<p class="text-sm text-gray-500 mb-1">Sisa Utang Aktif</p>
					<h3 class="text-2xl font-bold">Rp 15.000.000</h3>
					<div class="absolute top-2 right-2 flex space-x-1">
						<span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" title="Jatuh Tempo H-3"></span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- Dompet & Aset List -->
				<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 col-span-1">
					<div class="flex justify-between items-center mb-4">
						<h3 class="font-bold text-lg">Dompet Keluarga</h3>
						<button class="text-emerald-600 text-sm hover:underline">+ Tambah</button>
					</div>
					<div class="space-y-3">
						for _, w := range wallets {
							<div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
								<div>
									<p class="font-semibold">{ w.Name }</p>
									<p class="text-xs text-gray-500 capitalize">{ w.Type }</p>
								</div>
								<div class="font-bold text-gray-700">Rp { fmt.Sprintf("%.2f", w.Balance) }</div>
							</div>
						}
						<!-- Hardcoded Example if empty -->
						if len(wallets) == 0 {
							<div class="text-sm text-gray-500 text-center py-4">Belum ada dompet terdaftar.</div>
						}
					</div>

					<div class="mt-8 mb-4 border-t pt-4">
						<h3 class="font-bold text-lg">Aset Logam Mulia</h3>
					</div>
					<div class="flex justify-between items-center p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
						<div>
							<p class="font-semibold text-yellow-800">Emas Antam</p>
							<p class="text-xs text-yellow-600">10 Gram (24K)</p>
						</div>
						<div class="text-right">
							<div class="font-bold text-yellow-900">Rp 15.000.000</div>
							<div class="text-xs text-emerald-600">Live API 🟢</div>
						</div>
					</div>
				</div>

				<!-- Recent Transactions & Quick Add -->
				<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 col-span-1 lg:col-span-2">
					<div class="flex justify-between items-center mb-6">
						<h3 class="font-bold text-lg">Histori Transaksi</h3>
						<button @click="addTransactionModal = true" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl font-medium shadow transition">
							+ Catat Transaksi
						</button>
					</div>

					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse">
							<thead>
								<tr class="text-gray-400 text-sm border-b">
									<th class="pb-3 font-medium">Tanggal</th>
									<th class="pb-3 font-medium">Kategori</th>
									<th class="pb-3 font-medium">Keterangan</th>
									<th class="pb-3 font-medium">Nominal</th>
								</tr>
							</thead>
							<tbody class="text-sm">
								<tr class="border-b border-gray-50 hover:bg-gray-50 transition">
									<td class="py-4 text-gray-500">Hari ini, 08:30</td>
									<td class="py-4"><span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-semibold">Pengeluaran Dapur</span></td>
									<td class="py-4 text-gray-700">Belanja sayur & lauk pasar</td>
									<td class="py-4 font-bold text-red-600">- Rp 150.000</td>
								</tr>
								<tr class="border-b border-gray-50 hover:bg-gray-50 transition">
									<td class="py-4 text-gray-500">Kemarin, 19:00</td>
									<td class="py-4"><span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs font-semibold">Gaji Suami</span></td>
									<td class="py-4 text-gray-700">Gaji Bulan September</td>
									<td class="py-4 font-bold text-emerald-600">+ Rp 12.000.000</td>
								</tr>
								<tr class="border-b border-gray-50 hover:bg-gray-50 transition">
									<td class="py-4 text-gray-500">2 Sep 2026</td>
									<td class="py-4"><span class="bg-purple-100 text-purple-700 px-2 py-1 rounded text-xs font-semibold">Cicilan Utang</span></td>
									<td class="py-4 text-gray-700">Bayar cicilan motor bulan ke-4</td>
									<td class="py-4 font-bold text-red-600">- Rp 850.000</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- Alpine Modal: Tambah Transaksi -->
			<div x-cloak x-show="addTransactionModal" class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900 bg-opacity-75 backdrop-blur-sm"
				 x-transition.opacity>
				<div @click.outside="addTransactionModal = false" class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6 relative"
					 x-transition:enter="transition ease-out duration-300 transform"
					 x-transition:enter-start="opacity-0 translate-y-4 scale-95"
					 x-transition:enter-end="opacity-100 translate-y-0 scale-100">
					
					<div class="flex justify-between items-center mb-6">
						<h3 class="text-xl font-bold text-gray-900">Catat Transaksi Cepat</h3>
						<button @click="addTransactionModal = false" class="text-gray-400 hover:text-gray-600">✖</button>
					</div>

					<form action="/transactions" method="POST" class="space-y-4" x-data="{ type: 'expense', amount: '' }">
						
						<!-- Tipe Transaksi (Pemasukan / Pengeluaran) -->
						<div class="flex space-x-2 bg-gray-100 p-1 rounded-xl">
							<button type="button" @click="type = 'expense'" :class="type === 'expense' ? 'bg-white shadow text-red-600 font-bold' : 'text-gray-500 hover:text-gray-700'" class="flex-1 py-2 rounded-lg text-sm transition">Pengeluaran</button>
							<button type="button" @click="type = 'income'" :class="type === 'income' ? 'bg-white shadow text-emerald-600 font-bold' : 'text-gray-500 hover:text-gray-700'" class="flex-1 py-2 rounded-lg text-sm transition">Pemasukan</button>
						</div>

						<input type="hidden" name="type" x-model="type">

						<!-- Nominal (Rupiah Masking) -->
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Nominal (Rp)</label>
							<input type="text" x-model="amount" placeholder="0" class="w-full text-right text-2xl font-bold border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-emerald-500 focus:ring-emerald-500 outline-none transition" required>
						</div>

						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Dompet</label>
								<select name="wallet_id" class="w-full border-2 border-gray-200 rounded-xl px-3 py-2 bg-white" required>
									<option value="">Pilih Dompet...</option>
									<option value="1">BCA Suami</option>
									<option value="2">Uang Tunai Istri</option>
								</select>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Kategori</label>
								<select name="category" class="w-full border-2 border-gray-200 rounded-xl px-3 py-2 bg-white" required>
									<option x-show="type === 'expense'" value="dapur">Belanja Dapur</option>
									<option x-show="type === 'expense'" value="listrik">Listrik & Air</option>
									<option x-show="type === 'expense'" value="jajan">Jajan & Hiburan</option>
									<option x-show="type === 'income'" value="gaji">Gaji Utama</option>
									<option x-show="type === 'income'" value="bonus">Bonus / Sampingan</option>
								</select>
							</div>
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Keterangan Singkat</label>
							<input type="text" name="description" placeholder="Beli apa / dari siapa?" class="w-full border-2 border-gray-200 rounded-xl px-4 py-2 focus:border-emerald-500 outline-none">
						</div>

						<button type="submit" class="w-full mt-4 flex justify-center items-center bg-gray-900 hover:bg-black text-white font-bold py-3 px-4 rounded-xl transition shadow-lg">
							Simpan Transaksi
						</button>
					</form>
				</div>
			</div>
			
		</main>
	</body>
	</html>
}